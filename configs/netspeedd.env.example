# netspeedd environment configuration example
#
# Copy this file outside the source tree, edit it, then load it before starting:
#   set -a
#   . /etc/netspeedd.env
#   set +a
#   ./netspeedd
#
# Command-line flags override these variables. The daemon rejects malformed
# booleans, durations, integers, partial TLS pairs, and unsafe combinations.

# HTTP listener and endpoint-aware deadlines
NETSPEEDD_LISTEN_ADDR=":8080"
NETSPEEDD_READ_HEADER_TIMEOUT="10s"
NETSPEEDD_CONTROL_TIMEOUT="30s"
NETSPEEDD_TRANSFER_TIMEOUT="5m"
NETSPEEDD_IDLE_TIMEOUT="2m"
NETSPEEDD_MAX_BYTES="1073741824"
NETSPEEDD_SERVER_TIMING="true"

# Direct TLS. Configure both or neither. A configured pair is loaded and
# validated before the listener starts.
NETSPEEDD_TLS_CERT=""
NETSPEEDD_TLS_KEY=""

# Browser deployment. Wildcard origins cannot be used with credentials.
NETSPEEDD_ENABLE_CORS="true"
NETSPEEDD_ALLOWED_ORIGINS="*"
NETSPEEDD_CORS_ALLOW_CREDENTIALS="false"
NETSPEEDD_WEB_DIR="web"

# Metadata and locations
NETSPEEDD_LOCATIONS_FILE="configs/locations.example.json"
NETSPEEDD_HOSTNAME="speed.example.com"
NETSPEEDD_COLO="LOCAL"
NETSPEEDD_GEOIP_ASN_DB=""
NETSPEEDD_GEOIP_CITY_DB=""

# Forwarding headers are accepted only from these direct proxy networks.
# Leave empty when netspeedd receives client connections directly.
NETSPEEDD_TRUST_PROXY="false"
NETSPEEDD_TRUSTED_PROXY_CIDRS=""

# Transfer admission and per-client byte quota
NETSPEEDD_MAX_CONCURRENT_TRANSFERS="256"
NETSPEEDD_MAX_CONCURRENT_TRANSFERS_PER_CLIENT="24"
NETSPEEDD_CLIENT_BANDWIDTH_QUOTA_BYTES="1099511627776"
NETSPEEDD_CLIENT_BANDWIDTH_QUOTA_WINDOW="1h"

# WebRTC signaling/session controls
NETSPEEDD_MAX_WEBRTC_SESSIONS="64"
NETSPEEDD_MAX_WEBRTC_SESSIONS_PER_CLIENT="2"
NETSPEEDD_WEBRTC_OFFER_RATE_PER_MINUTE="12"
NETSPEEDD_WEBRTC_OFFER_BURST="4"
NETSPEEDD_TURN_CREDENTIAL_RATE_PER_MINUTE="60"
NETSPEEDD_TURN_CREDENTIAL_BURST="10"
NETSPEEDD_MAX_OFFER_BODY_BYTES="131072"
NETSPEEDD_MAX_REPORT_BODY_BYTES="16384"

# Optional bearer authentication. Use long random values in production.
NETSPEEDD_ACCESS_TOKEN=""
NETSPEEDD_ENABLE_METRICS="false"
NETSPEEDD_METRICS_TOKEN=""

# External STUN/TURN. A TURN URL requires a shared HMAC secret. STUN-only
# configuration does not. Comma-separate multiple URLs.
NETSPEEDD_TURN_SERVERS=""
NETSPEEDD_TURN_SECRET=""
NETSPEEDD_TURN_REALM="netspeed"
NETSPEEDD_MAX_TURN_TTL="600"

# Embedded TURN is opt-in and loopback-only by default. A non-loopback listener
# requires NETSPEEDD_EMBEDDED_TURN_PUBLIC_IP.
NETSPEEDD_EMBEDDED_TURN="false"
NETSPEEDD_EMBEDDED_TURN_ADDR="127.0.0.1:3478"
NETSPEEDD_EMBEDDED_TURN_PUBLIC_IP=""
NETSPEEDD_EMBEDDED_TURN_MAX_MBPS="100"
